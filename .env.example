# ==============================================================================
# AI Engineering Platform Environment Configuration (.env)
# ==============================================================================

# Layer 1: Model Provider Selection (gemini | groq | ollama | claude | openai)
LLM_PROVIDER=gemini

# Google Gemini (Free tier from https://aistudio.google.com/)
GEMINI_API_KEY=""

# Groq Cloud (Free tier from https://console.groq.com/)
GROQ_API_KEY=""

# Local Ollama Host (default: http://localhost:11434)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2:3b"

# Layer 6: Observability (Langfuse - cloud or self-hosted)
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_SECRET_KEY=""
LANGFUSE_HOST="https://cloud.langfuse.com"

# External DevSecOps Integrations (Optional)
SONARQUBE_URL="http://localhost:9000"
SONARQUBE_TOKEN=""
DEFECTDOJO_URL="http://localhost:8080"
DEFECTDOJO_API_KEY=""
